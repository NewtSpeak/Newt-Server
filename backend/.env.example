APP_ADDRESS=:8080
APP_ENV=development
DATABASE_URL=postgres://owl:owl_dev_password@127.0.0.1:5432/owl?sslmode=disable
JWT_SECRET=replace-this-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
FRONTEND_DEV_URL=http://127.0.0.1:5173
FRONTEND_DIST_PATH=web/dist

# ---- 可观测（OTLP → SigNoz，见 ../deploy/signoz/README.md）----
# 留空则不启用导出（no-op）；本地 SigNoz 默认 gRPC 端口 4317
#OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
#OTEL_EXPORTER_OTLP_PROTOCOL=grpc
#OTEL_SERVICE_NAME=owl-server
#OTLP_INSECURE=true

# ---- 审计日志保留天数（0 或不配置 = 永久保留）----
#AUDIT_RETENTION_DAYS=180

# ---- 邀请分享落地页 ----
# 对外可访问的服务根地址，用于拼接分享链接 /invite/{code} 与深链参数；
# 留空时按请求 Host 推导（反代场景建议显式配置）。
#PUBLIC_BASE_URL=https://chat.example.com
