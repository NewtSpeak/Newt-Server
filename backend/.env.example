APP_ADDRESS=:8080
APP_ENV=development
DATABASE_URL=postgres://owl:owl_dev_password@127.0.0.1:5432/owl?sslmode=disable
JWT_SECRET=replace-this-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
FRONTEND_DEV_URL=http://127.0.0.1:5173
FRONTEND_DIST_PATH=web/dist

# ---- 可观测（OTLP → SigNoz，见 ../deploy/signoz/README.md）----
# 留空则不启用导出（no-op）；本地 SigNoz 默认 gRPC 端口 4317
#OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
#OTEL_EXPORTER_OTLP_PROTOCOL=grpc
#OTEL_SERVICE_NAME=owl-server
#OTLP_INSECURE=true

# ---- 审计日志保留天数（0 或不配置 = 永久保留）----
#AUDIT_RETENTION_DAYS=180

# ---- 音频审计上传（SFU → 主节点 /audit-api/records）----
# 开发环境留空时会从 JWT_SECRET 自动派生密钥，并通过 RegisterAck 下发给 SFU。
# 生产环境请显式设置，并配置 PUBLIC_BASE_URL（用于拼 audit_ingest_url）。
#AUDIT_INGEST_TOKEN=replace-with-long-random-shared-secret

# ---- 内嵌本地 SFU（启动时自动拉起 owl-sfu，开发默认开启）----
#EMBEDDED_SFU=true
#EMBEDDED_SFU_BIN=/path/to/owl-sfu
#EMBEDDED_SFU_WSS_LISTEN=:8445
#EMBEDDED_SFU_MEDIA_UDP=3478
#EMBEDDED_SFU_PUBLIC_IP=127.0.0.1
#EMBEDDED_SFU_NO_TLS=true

# ---- 邀请分享落地页 / 审计上传基址 ----
# 对外可访问的服务根地址，用于拼接分享链接 /invite/{code}、深链，以及
# SFU 审计上传地址（{PUBLIC_BASE_URL}/audit-api/records）。
# 开发环境留空时默认 http://127.0.0.1{APP_ADDRESS}；生产反代场景请显式配置。
#PUBLIC_BASE_URL=https://chat.example.com
