#!/usr/bin/env bash
# NewtSpeak SFU 节点自动部署 —— 阶段二：写配置、装 systemd、启动并等待健康。
# 本脚本含一次性 enrollment token，故全程禁用命令回显（不得开启 shell 调试跟踪）。
set -euo pipefail

INSTALL_DIR={{.InstallDir}}

log()  { echo "[+] $*"; }
warn() { echo "[!] $*"; }
err()  { echo "[x] $*"; exit 1; }

systemctl stop newt-sfu >/dev/null 2>&1 || true
{{- if .ForceReinstall }}
log "强制重装：清空节点身份目录（原证书作废，节点将重新 enroll）"
rm -rf "$INSTALL_DIR/data/sfu"
{{- end }}
mkdir -p "$INSTALL_DIR/data/sfu"
chmod 700 "$INSTALL_DIR/data/sfu"

# ---- 环境变量 ----
umask 077
cat > "$INSTALL_DIR/newt-sfu.env" <<'NEWTSFU_ENV_EOF'
# 由 Newt-Server 自动部署生成，请勿手工编辑（重新部署会覆盖）
NEWTSFU_NODE_ID={{.NodeID}}
NEWTSFU_ENROLL_TOKEN={{.EnrollToken}}
NEWTSFU_SERVER_ENROLL_ENDPOINT={{.ControlEndpoint}}
NEWTSFU_ENROLL_INSECURE={{.EnrollInsecure}}
NEWTSFU_DATA_DIR={{.InstallDir}}/data/sfu
NEWTSFU_WSS_LISTEN={{.WSSListen}}
NEWTSFU_NO_TLS={{.NoTLS}}
{{- if .TLSCertFile }}
NEWTSFU_TLS_CERT_FILE={{.TLSCertFile}}
NEWTSFU_TLS_KEY_FILE={{.TLSKeyFile}}
{{- end }}
NEWTSFU_MEDIA_UDP_PORT={{.MediaUDPPort}}
NEWTSFU_PUBLIC_IP={{.PublicIP}}
NEWTSFU_ADVERTISE_WSS_URL={{.AdvertiseWssURL}}
{{- if .EnableCascade }}
NEWTSFU_CASCADE_LISTEN=0.0.0.0:8843
NEWTSFU_ADVERTISE_CASCADE_ENDPOINT={{.PublicIP}}:8843
{{- end }}
NEWTSFU_MAX_USERS={{.MaxUsers}}
NEWTSFU_ENV_EOF
chmod 600 "$INSTALL_DIR/newt-sfu.env"
log "已写入 $INSTALL_DIR/newt-sfu.env"

# ---- systemd 单元 ----
cat > /etc/systemd/system/newt-sfu.service <<'NEWTSFU_UNIT_EOF'
[Unit]
Description=NewtSpeak SFU Media Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory={{.InstallDir}}
EnvironmentFile={{.InstallDir}}/newt-sfu.env
ExecStart={{.InstallDir}}/bin/newt-sfu
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

ReadWritePaths={{.InstallDir}}/data

[Install]
WantedBy=multi-user.target
NEWTSFU_UNIT_EOF
log "已写入 /etc/systemd/system/newt-sfu.service"

{{- if .InstallCaddy }}

# ---- Caddy 反向代理（自动申请 Let's Encrypt 证书）----
mkdir -p /etc/caddy/newtspeak.d
cat > /etc/caddy/newtspeak.d/newt-sfu.caddy <<'NEWTSFU_CADDY_EOF'
{{.Domain}} {
	encode gzip zstd
	reverse_proxy 127.0.0.1:{{.LocalWSSPort}} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			versions 1.1
		}
	}
}
NEWTSFU_CADDY_EOF
touch /etc/caddy/Caddyfile
if ! grep -q 'newtspeak.d' /etc/caddy/Caddyfile 2>/dev/null; then
  printf '\nimport /etc/caddy/newtspeak.d/*.caddy\n' >> /etc/caddy/Caddyfile
fi
log "已写入 Caddy 站点 {{.Domain}} → 127.0.0.1:{{.LocalWSSPort}}"
systemctl enable caddy >/dev/null 2>&1 || true
if systemctl reload caddy >/dev/null 2>&1 || systemctl restart caddy >/dev/null 2>&1; then
  log "Caddy 已重载"
else
  journalctl -u caddy -n 30 --no-pager || true
  err "Caddy 重载失败，请检查 /etc/caddy/Caddyfile"
fi
{{- end }}

# ---- 启动 ----
systemctl daemon-reload
systemctl reset-failed newt-sfu >/dev/null 2>&1 || true
systemctl enable newt-sfu >/dev/null 2>&1 || true
log "启动 newt-sfu..."
systemctl restart newt-sfu

HEALTHY=0
for i in $(seq 1 20); do
  sleep 2
  if ! systemctl is-active --quiet newt-sfu; then
    continue
  fi
  if curl -fsS --max-time 3 "http://127.0.0.1:{{.LocalWSSPort}}/healthz" >/dev/null 2>&1; then
    HEALTHY=1
    break
  fi
done

if [ "$HEALTHY" -ne 1 ]; then
  warn "newt-sfu 健康检查未通过，最近日志："
  journalctl -u newt-sfu -n 60 --no-pager || true
  err "newt-sfu 启动失败或未在 40 秒内就绪"
fi
log "newt-sfu 已启动并通过本机健康检查"

{{- if .InstallCaddy }}
if curl -skI --max-time 8 "https://{{.Domain}}/healthz" >/dev/null 2>&1; then
  log "公网 HTTPS 可达：https://{{.Domain}}"
else
  warn "https://{{.Domain}} 暂不可达。若域名刚解析，Let's Encrypt 签发可能仍在进行；请确认 A 记录指向本机且 80/443 未被占用"
fi
{{- end }}

echo "PHASE2_OK"
