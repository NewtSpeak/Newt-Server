#!/usr/bin/env bash
# NewtSpeak SFU 节点自动部署 —— 阶段一：环境依赖与二进制。
# 幂等：可重复执行。裁剪自 deploy/prod/install.sh（去掉 docker/postgres/newt-server）。
set -euo pipefail

INSTALL_DIR={{.InstallDir}}

log()  { echo "[+] $*"; }
warn() { echo "[!] $*"; }
err()  { echo "[x] $*"; exit 1; }

# ---- 系统与架构探测 ----
KERNEL=$(uname -s)
[ "$KERNEL" = "Linux" ] || { echo "[x] 目标机操作系统为 $KERNEL，自动部署仅支持 Linux"; exit 21; }
case "$(uname -m)" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) echo "[x] 不支持的 CPU 架构 $(uname -m)（仅 amd64 / arm64）"; exit 22 ;;
esac
log "系统 Linux/$ARCH"

command -v systemctl >/dev/null 2>&1 || err "目标机没有 systemd，无法安装 newt-sfu 服务"

# ---- 已有安装检测 ----
if [ -f "$INSTALL_DIR/newt-sfu.env" ]; then
{{- if .ForceReinstall }}
  OLD_NODE=$(grep -oP '^NEWTSFU_NODE_ID=\K.*' "$INSTALL_DIR/newt-sfu.env" 2>/dev/null || true)
  warn "检测到已有安装（原 node_id=${OLD_NODE:-未知}），按要求强制重装；原节点记录需在面板手动清理"
{{- else }}
  OLD_NODE=$(grep -oP '^NEWTSFU_NODE_ID=\K.*' "$INSTALL_DIR/newt-sfu.env" 2>/dev/null || true)
  echo "[x] 目标机已安装 newt-sfu（node_id=${OLD_NODE:-未知}）。如需覆盖请勾选「强制重装」"
  exit 23
{{- end }}
fi

# ---- 系统依赖 ----
export DEBIAN_FRONTEND=noninteractive
if command -v apt-get >/dev/null 2>&1; then
  log "安装系统包（curl ca-certificates openssl{{if .ConfigureUFW}} ufw{{end}}）..."
  apt-get update -y >/dev/null
  apt-get install -y curl ca-certificates openssl{{if .ConfigureUFW}} ufw{{end}} >/dev/null
{{- if .InstallCaddy }}
  if ! command -v caddy >/dev/null 2>&1; then
    log "安装 Caddy（用于 {{.Domain}} 的 HTTPS 证书自动签发）..."
    apt-get install -y debian-keyring debian-archive-keyring apt-transport-https gnupg >/dev/null
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
      | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
      > /etc/apt/sources.list.d/caddy-stable.list
    apt-get update -y >/dev/null
    apt-get install -y caddy >/dev/null
  else
    log "Caddy 已安装"
  fi
{{- end }}
elif command -v dnf >/dev/null 2>&1 || command -v yum >/dev/null 2>&1; then
  PM=$(command -v dnf || command -v yum)
  log "安装系统包（$PM）..."
  $PM install -y curl ca-certificates openssl >/dev/null
{{- if .InstallCaddy }}
  command -v caddy >/dev/null 2>&1 || err "该发行版需手动安装 Caddy 后再部署：https://caddyserver.com/docs/install"
{{- end }}
else
  warn "未知发行版，跳过包管理器安装；将直接校验所需命令"
fi

command -v curl >/dev/null 2>&1 || err "缺少 curl，请先手动安装"
{{- if .InstallCaddy }}
command -v caddy >/dev/null 2>&1 || err "缺少 caddy，请先手动安装"
{{- end }}

# ---- 目录 ----
mkdir -p "$INSTALL_DIR/bin" "$INSTALL_DIR/data/sfu"
chmod 700 "$INSTALL_DIR/data/sfu"

# ---- 与 Server 的连通性预检 ----
log "检查与 Newt-Server 的连通性..."
curl -fsS --max-time 10 -o /dev/null {{.ServerHealthURL}} \
  || err "无法访问 Newt-Server（{{.ServerHealthURL}}）。请确认 PUBLIC_BASE_URL 对该节点可达"
if ! timeout 5 bash -c 'cat < /dev/null > /dev/tcp/{{.ControlHost}}/{{.ControlPort}}' 2>/dev/null; then
  warn "无法建立到控制面 {{.ControlHost}}:{{.ControlPort}} 的 TCP 连接，节点可能无法 enroll（请检查防火墙与 SFU_CONTROL_PUBLIC_ENDPOINT）"
fi

# ---- 下载二进制 ----
log "下载 newt-sfu（{{.ReleaseName}}）..."
curl -fSL --retry 3 --retry-delay 2 --max-time 600 \
  -o "$INSTALL_DIR/bin/newt-sfu.new" "{{.BinaryURL}}" \
  || err "下载 newt-sfu 失败：{{.BinaryURL}}"
{{- if .BinarySHA256 }}
echo "{{.BinarySHA256}}  $INSTALL_DIR/bin/newt-sfu.new" | sha256sum -c - \
  || err "newt-sfu 二进制 SHA-256 校验失败"
log "SHA-256 校验通过"
{{- end }}
chmod +x "$INSTALL_DIR/bin/newt-sfu.new"
mv -f "$INSTALL_DIR/bin/newt-sfu.new" "$INSTALL_DIR/bin/newt-sfu"
log "二进制就绪：$INSTALL_DIR/bin/newt-sfu"

{{- if .ConfigureUFW }}

# ---- 防火墙 ----
if command -v ufw >/dev/null 2>&1; then
  log "放行端口（22/tcp, 80/tcp, 443/tcp, {{.MediaUDPPort}}/udp{{if .EnableCascade}}, 8843/tcp{{end}}）..."
  ufw allow 22/tcp   >/dev/null 2>&1 || true
  ufw allow 80/tcp   >/dev/null 2>&1 || true
  ufw allow 443/tcp  >/dev/null 2>&1 || true
  ufw allow {{.MediaUDPPort}}/udp >/dev/null 2>&1 || true
{{- if .EnableCascade }}
  ufw allow 8843/tcp >/dev/null 2>&1 || true
{{- end }}
{{- if not .NoTLS }}
  ufw allow 8443/tcp >/dev/null 2>&1 || true
{{- end }}
  # 不执行 ufw enable，避免误锁 SSH
else
  warn "未检测到 ufw，跳过防火墙配置；请自行放行 {{.MediaUDPPort}}/udp 与 443/tcp"
fi
{{- end }}

# ---- 公网 IP 探测 ----
DETECTED_IP="{{.PublicIP}}"
if [ -z "$DETECTED_IP" ]; then
  DETECTED_IP=$(curl -4fsS --max-time 8 https://api.ipify.org 2>/dev/null || true)
  [ -n "$DETECTED_IP" ] || DETECTED_IP="{{.SSHHost}}"
  log "自动探测公网 IP：$DETECTED_IP"
fi

echo "PHASE1_OK arch=$ARCH public_ip=$DETECTED_IP"
